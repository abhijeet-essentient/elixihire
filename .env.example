# ---------------------------------------------------------------------------
# Access credential for the restricted demo.
#
# These are read at BUILD time and inlined into the static bundle, so changing
# them in Vercel requires a redeploy before the change takes effect.
#
# Because this is a static site with no server, the check runs in the visitor's
# browser. Treat this as a deterrent against a stray URL, not as security — see
# "Access control" in the README for the real option.
# ---------------------------------------------------------------------------

# Username reviewers type. Defaults to "essentient" if unset.
NEXT_PUBLIC_DEMO_USERNAME=essentient

# PREFERRED: SHA-256 hash of the password, so the plaintext is not in the bundle.
# Generate with:  npm run hash-password -- 'your-password'
NEXT_PUBLIC_DEMO_PASSWORD_SHA256=

# FALLBACK (simpler, weaker): plaintext password. Readable by anyone who opens the
# deployed JS. Only use this if you cannot run the hash script; the login screen
# will display a warning while it is in use.
# NEXT_PUBLIC_DEMO_PASSWORD=
